    {
      "parameters": {
        "numberInputs": 7
      },
      "id": "190efff8-1faa-4afa-8b38-a69520a32599",
      "name": "Merge All Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        176,
        48
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise all items into a unified shape\nconst items = $input.all();\nconst normalised = [];\n\nfor (const item of items) {\n  const d = item.json;\n\n  // RSS feed items (Tanium blog / docs)\n  if (d.title && d.link) {\n    const pubDate = d.pubDate || d.isoDate || d.date || '';\n    const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n    const pub = new Date(pubDate);\n    if (pub > sevenDaysAgo || !pubDate) {\n      // Auto-detect competitor from title/summary content\nconst text = (d.title + ' ' + (d.contentSnippet || '')).toLowerCase();\nconst competitor = text.includes('ivanti') ? 'Ivanti' \n                 : text.includes('manageengine') ? 'ManageEngine' \n                 : 'Tanium';\n\nnormalised.push({\n  source: competitor + ' RSS',\n  title: d.title || '',\n  url: d.link || '',\n  summary: (d.contentSnippet || d.content || d.description || '').substring(0, 500),\n  published: pubDate,\n  competitor: competitor,\n  category: 'Blog / Docs'\n});\n    }\n    continue;\n  }\n\n  // NewsAPI response\n  if (d.articles) {\n    for (const art of d.articles) {\n      const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n      const pub = new Date(art.publishedAt);\n      if (pub > sevenDaysAgo) {\n        const text = (art.title + ' ' + (art.description || '')).toLowerCase();\nconst competitor = text.includes('ivanti') ? 'Ivanti'\n                 : text.includes('manageengine') ? 'ManageEngine'\n                 : 'Tanium';\n\nnormalised.push({\n  source: art.source?.name || 'News',\n  title: art.title || '',\n  url: art.url || '',\n  summary: (art.description || art.content || '').substring(0, 500),\n  published: art.publishedAt,\n  competitor: competitor,\n  category: 'News'\n});\n      }\n    }\n  }\n}\n\nif (normalised.length === 0) {\n  return [{ json: { no_new_items: true, message: 'No new Tanium content this week.' } }];\n}\n\n// Deduplicate by URL\nconst seen = new Set();\nconst deduped = normalised.filter(n => {\n  if (seen.has(n.url)) return false;\n  seen.add(n.url);\n  return true;\n});\n\nreturn deduped.map(n => ({ json: n }));\n"
      },
