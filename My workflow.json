      "id": "fb992880-bc5d-4f77-8a8a-3fcba7da42c6",
      "name": "Any New Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        672,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate all items and build a prompt for Claude\nconst items = $input.all();\n\nconst itemList = items.map((item, i) => {\n  const d = item.json;\n  return '[' + (i+1) + '] COMPETITOR: ' + d.competitor + '\\nSOURCE: ' + d.source + '\\nTITLE: ' + d.title + '\\nURL: ' + d.url + '\\nPUBLISHED: ' + d.published + '\\nSUMMARY: ' + d.summary + '\\n';\n}).join('\\n---\\n');\n\nconst prompt = 'You are a Senior Product Intelligence Analyst for HCL BigFix Compliance.\\n\\n'\n  + 'Below are ' + items.length + ' recent items from Tanium, Ivanti, and ManageEngine (direct BigFix competitors) published in the last 7 days.\\n\\n'\n  + 'Analyse them and produce a structured competitive intelligence brief with EXACTLY this format:\\n\\n'\n  + '## EXECUTIVE SUMMARY\\n'\n  + 'One paragraph (3-5 sentences) covering the most strategically important signals this week across ALL three competitors.\\n\\n'\n  + '## KEY SIGNALS (top 5, ranked by importance to BigFix Compliance PM)\\n'\n  + 'For each signal:\\n'\n  + '- Red/Yellow/Green THREAT LEVEL (Red=high threat, Yellow=watch, Green=opportunity)\\n'\n  + '- COMPETITOR: Which competitor this is about\\n'\n  + '- SIGNAL: What they did / announced / changed\\n'\n  + '- BIGFIX IMPLICATION: What this means for BigFix Compliance strategy\\n'\n  + '- RECOMMENDED ACTION: Concrete PM action (PRD update / roadmap item / talking point)\\n\\n'\n  + '## COMPETITOR COMPARISON\\n'\n  + 'A brief side-by-side of what each competitor focused on this week:\\n'\n  + '- Tanium:\\n'\n  + '- Ivanti:\\n'\n  + '- ManageEngine:\\n\\n'\n  + '## FEATURE GAPS IDENTIFIED\\n'\n  + 'List any features Tanium/Ivanti/ManageEngine are emphasising that BigFix Compliance currently lacks.\\n\\n'\n  + '## BIGFIX DIFFERENTIATION OPPORTUNITIES\\n'\n  + 'Where can BigFix Compliance double down to stand out against all three?\\n\\n'\n  + '## ITEMS ANALYSED\\n'\n  + 'List all ' + items.length + ' items as: [N] Competitor - Title - URL\\n\\n'\n  + '---\\nRAW DATA:\\n'\n  + itemList\n  + '\\n\\nRespond only with the structured brief above. Be direct and specific - this is for a PM Monday morning review.';\n\nreturn [{ json: { prompt, item_count: items.length } }];"
      },
      "id": "52110076-f71c-4dfc-954c-20f30245ea10",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract Gemini's text response and prepare for Google Sheets\nconst geminiResponse = $input.first().json;\nconst itemCountNode = $('Build Claude Prompt').first().json;\n\nlet analysisText = '';\ntry {\n  // Gemini response format is different from Claude\n  analysisText = geminiResponse.candidates[0].content.parts[0].text;\n} catch(e) {\n  analysisText = 'Error extracting Gemini response: ' + JSON.stringify(geminiResponse);\n}\n\n// Fix line breaks — convert \\n to actual newlines\nanalysisText = analysisText.replace(/\\\\n/g, '\\n');\n\n// Parse threat level counts from text\nconst redCount = (analysisText.match(/🔴/g) || []).length;\nconst yellowCount = (analysisText.match(/🟡/g) || []).length;\nconst greenCount = (analysisText.match(/🟢/g) || []).length;\n\n// Extract executive summary\nconst execMatch = analysisText.match(/## EXECUTIVE SUMMARY\\n([\\s\\S]*?)(?=\\n##)/);\nconst execSummary = execMatch ? execMatch[1].trim() : analysisText.substring(0, 500);\n\n// Week label\nconst weekStart = new Date();\nweekStart.setDate(weekStart.getDate() - weekStart.getDay() + 1);\nconst weekLabel = weekStart.toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    week: weekLabel,\n    competitor: 'Tanium',\n    items_analysed: itemCountNode.item_count || 0,\n    red_threats: redCount,\n    yellow_watch: yellowCount,\n    green_opps: greenCount,\n    exec_summary: execSummary,\n    full_analysis: analysisText,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
